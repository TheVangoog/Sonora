{
  "name": "sonora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "make:synthetic": "node scripts/make-synthetic-set.ts",
    "eval": "node scripts/evaluate.ts tests/recordings/real",
    "eval:synthetic": "node scripts/evaluate.ts tests/recordings/synthetic",
    "make:guitarset": "node scripts/make-guitarset-set.ts",
    "eval:guitarset": "node scripts/evaluate.ts tests/recordings/guitarset-segments",
    "make:guitarset-ext": "node scripts/make-guitarset-set.ts --extended",
    "eval:guitarset-ext": "node scripts/evaluate.ts tests/recordings/guitarset-segments-ext",
    "tune:basic-pitch": "node scripts/tune-basic-pitch.ts",
    "bench:basic-pitch": "node scripts/bench-basic-pitch.ts",
    "tune:chord-rules": "node scripts/tune-chord-rules.ts",
    "replay:live": "node scripts/replay-live.ts"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "pitchy": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
